# Commercial market data. Primary Tushare-compatible source plus optional ProMax failover.
TUSHARE_PRIMARY_TOKEN=
TUSHARE_PRIMARY_API_URL=
TUSHARE_FALLBACK_URL=
TUSHARE_FALLBACK_API_KEY=

# Legacy single-provider names remain supported.
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro

# China/global finance aggregation. Qinghong is the primary feed; NewsAPI can remain as an optional fallback.
QINGHONG_BASE_URL=http://124.223.180.129:3220
QINGHONG_PRO_API_KEY=
QINGHONG_API_KEY=

# Local launchd is the default scheduler. Enable this only when no external scheduler is running.
LOCAL_IN_PROCESS_SCHEDULER=false
LOCAL_SCHEDULER_BASE_URL=http://127.0.0.1:4173
# Set only after publishing the updated worker; cloud notification sends are suppressed.
SITES_SCHEDULER_BASE_URL=

# Global news aggregation. Use a NewsAPI plan licensed for production redistribution.
NEWSAPI_KEY=

# Real AI research. MiniMax M3 is primary; OpenAI remains an optional fallback.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# Hard call cap per deployment / Shanghai calendar day, not a currency spending cap.
AI_DAILY_CALL_LIMIT=200

# Optional OpenAI fallback. Keep all keys server-side; never expose them to Vite/browser variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Optional external quant engine. When omitted, the built-in 12-Agent engine uses the configured Tushare-compatible source.
QUANT_ENGINE_URL=
QUANT_ENGINE_TOKEN=

# Protect manual production job execution.
ADMIN_API_TOKEN=

# Local teacher-folder ingestion. Set rights confirmation only for materials authorized for this project.
KNOWLEDGE_SYNC_BASE_URL=http://127.0.0.1:4173
KNOWLEDGE_RIGHTS_CONFIRMED=false

# Optional audio transcription gateway. Without it, add a matching *.transcript.md or *.transcript.txt file.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_TOKEN=

# Optional delivery gateway for WeCom, Feishu, SMS, email, or a dedicated web-push service.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
