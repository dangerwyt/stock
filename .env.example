# 环境变量模板 —— 复制成 .env 后填写：cp .env.example .env
#
# ⚠️ 字段名以 backend/app/config.py 的 Settings 为准（pydantic-settings 读的就是这些键）。
# 前端不需要任何环境变量：生产环境由 nginx 把 /api 反代到后端（见 frontend/nginx.conf），
# 所以**不要**把密钥写成 VITE_* 变量 —— 那会被打进浏览器可见的包。

# ── LLM（AI 研究室会诊 / 自动提炼画像）──────────────────────────
# 不填则所有 AI 功能报错（其余功能仍可用）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# 通道：langchain（默认，走 OpenAI 兼容端点）| minimax_v2（原生端点，更快更省）
LLM_BACKEND=langchain
AI_DAILY_CALL_LIMIT=200
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=3000

# ── Tushare 行情（TOP50 / 个股搜索 / 快照）─────────────────────
# 主源：第三方中继，POST 到根路径，自签证书 → 必须 TUSHARE_VERIFY_SSL=false
TUSHARE_API_URL=https://quantdata888.duckdns.org
TUSHARE_TOKEN=
TUSHARE_VERIFY_SSL=false
# 备用源（B 套 ProMax 聚合接口，GET + X-API-Key）；主源挂掉时自动回落
TUSHARE_FALLBACK_URL=https://pcd.mobcvb.cn/tushare/pro
TUSHARE_FALLBACK_API_KEY=

# ── 资讯（/api/news，按 晴红 → NewsAPI → Tushare 顺序回落）─────
QINGHONG_BASE_URL=http://124.223.180.129:3220
QINGHONG_API_KEY=
# 可留空：留空时跳过这一路，不会造假数据
NEWSAPI_KEY=

# ── 运行参数 ────────────────────────────────────────────────
APP_ENV=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 生产为同源部署（前端由 nginx 托管并反代 /api），给同源地址即可
FRONTEND_ORIGIN=http://localhost

# 管理接口鉴权 —— 生产环境务必设置
ADMIN_API_TOKEN=

# ── 资料与上传限制 ──────────────────────────────────────────
# 留空则用默认路径 backend/app/data/agent_docs（compose 里挂成 volume）
AGENT_DOCS_DIR=
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=30
MAX_DOCUMENT_CHARS=20000

# ── 定时任务：每天按「资料 + 会话历史」自动更新自建角色画像 ──────
# ⚠️ 跑在后端进程内（APScheduler），因此后端必须单进程运行
AUTO_EXTRACT_ENABLED=true
AUTO_EXTRACT_HOUR=9
AUTO_EXTRACT_MINUTE=0

# ── 策略权重与共识阈值（一般不用改，列出来是方便调参）──────────
# 自建老师画像在 TOP50 打分中的权重份额（1.0 = 完全接管，内置 12 位仅兜底）
CUSTOM_TEACHER_WEIGHT_SHARE=1.0
# 四周期加权时的周期倾斜强度 λ（0~1）
#   0.0 → 纯画像，四个周期榜单完全相同（仅用于对照，不要用在生产）
#   0.5 → 画像与持有周期各占一半（**推荐，与代码默认值一致**）
#   1.0 → 纯周期基线，AI 画像不再影响该周期
# ⚠️ 这里若留 0.0，会踩中「超短/短线/中线/中长线 四张榜单长得一模一样」那个 bug。
CYCLE_TILT_STRENGTH=0.5
# 资料相关性过滤（上传资料与角色的相关度筛选）
DOC_RELEVANCE_ENABLED=true
# 会诊认定为「共识」所需的最少独立完成人数
MIN_CONSENSUS_PARTICIPANTS=3
